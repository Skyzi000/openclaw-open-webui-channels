# Open WebUI base URL
base_url=http://localhost:3000

# Butler account (default)
butler_email=butler@example.com
butler_password=changeme

# Researcher account
researcher_email=researcher@example.com
researcher_password=changeme

# Shared channel where both bots are present
shared_channel_id=00000000-0000-0000-0000-000000000001

# Butler-only channel
butler_channel_id=00000000-0000-0000-0000-000000000002

# Researcher-only channel
researcher_channel_id=00000000-0000-0000-0000-000000000003
